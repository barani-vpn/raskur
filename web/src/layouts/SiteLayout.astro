---
import '../styles/global.css';
import Announcement from '../components/Announcement.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, langs, origin, publicPath, ui, type Lang, type Link, type Site } from '../content/site';

interface Props {
  site: Site;
  lang: Lang;
  path: string;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  announcement?: { text: string; link?: Link };
}

const { site, lang, path, title, description, ogTitle = title, ogDescription = description, announcement } = Astro.props;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const canonical = absolute(site, path, lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {langs.map((l) => <link rel="alternate" hreflang={l} href={absolute(site, path, l)}>)}
  <meta property="og:type" content="website">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${origin[site]}/images/og.jpg`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1c0e25">
  <slot name="head" />
  <link rel="icon" type="image/png" href="/images/favicon32.png">
  <link rel="preload" href="/fonts/Dodo_Rounded_v2-VF.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="skip" href="#main">{ui[lang].skip}</a>
  {announcement && <Announcement {...announcement} />}
  <Header {site} {lang} currentHref={publicPath(path, lang)} switchHref={publicPath(path, other)} />
  <main id="main"><slot /></main>
  <Footer {site} {lang} />
</body>
</html>
