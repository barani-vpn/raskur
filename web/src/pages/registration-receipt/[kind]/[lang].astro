---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { registrationCopy, type RegistrationKind } from '../../../content/registration';
import { langs, publicPath, type Lang } from '../../../content/site';

export function getStaticPaths() {
  return ['cloud', 'edu'].flatMap((kind) => langs.map((lang) => ({ params: { kind, lang } })));
}
const { kind, lang } = Astro.params as { kind: RegistrationKind; lang: Lang };
const c = registrationCopy[lang];
const site = kind === 'cloud' ? 'cloud' : 'apex';
const register = publicPath(kind === 'cloud' ? '/register/' : '/grants/register/', lang);
---
<SiteLayout {site} {lang} path="/requests/__REQUEST_ID__" title={`${c[kind].title} | Додо Раскур`} description={c[kind].note}>
  <meta slot="head" name="robots" content="noindex, nofollow">
  <section class="wrap receipt" data-request-state="__REQUEST_STATE__">
    <p class="eyebrow">{c[kind].eyebrow}</p>
    <h1><span class="received">{c.receipt}</span><span class="withdrawn">{c.withdrawn}</span></h1>
    <p class="intro received">{c.receiptText}</p>
    <p class="intro withdrawn">{c.withdrawnText}</p>
    <div class="received">
      <dl><dt>{c.reference}</dt><dd><code>__REQUEST_ID__</code></dd></dl>
      <p class="hint">{c.keepLink}</p>
      <p class="scope">{c[kind].note}</p>
      <details>
        <summary>{c.withdrawTitle}</summary>
        <p>{c.withdrawText}</p>
        <form method="post" action="/api/registrations/withdraw">
          <input type="hidden" name="id" value="__REQUEST_ID__">
          <input type="hidden" name="lang" value={lang}>
          <button type="submit">{c.withdraw}</button>
        </form>
      </details>
    </div>
    <a class="text-link" href={register}>{c.registerAgain} →</a>
  </section>
</SiteLayout>

<style>
  .receipt{padding-block:70px;max-width:850px;min-height:60vh}
  h1{max-width:none;font-size:clamp(34px,4vw,52px)}
  .eyebrow{color:var(--plum)}
  .intro{font-size:19px;margin-top:26px;color:var(--muted)}
  dl{margin:30px 0 12px;padding:22px;border:1px solid var(--line);border-radius:6px;background:var(--surface)}
  dt{font-size:12px;color:var(--muted);margin-bottom:8px}
  code{font-size:16px;overflow-wrap:anywhere}
  .hint,.scope{font-size:13px;color:var(--muted)}
  .scope{margin-top:20px}
  details{border-block:1px solid var(--line);margin:30px 0;padding:14px 0}
  form{margin-top:18px}
  button{font:inherit;font-size:13px;cursor:pointer;padding:10px 14px;border:1px solid var(--plum);border-radius:4px;color:var(--plum);background:#fff}
  [data-request-state=received] .withdrawn,[data-request-state=withdrawn] .received{display:none}
  .text-link{display:inline-block;margin-top:24px}
</style>
